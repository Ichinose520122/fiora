FROM node:22-bookworm-slim
WORKDIR /api
# Keep the released API version and apply only the upstream mobile-SMS fix.
# Installing the contributor branch directly would downgrade the full package.
RUN npm install --omit=dev --ignore-scripts --no-audit --no-fund \
    @neteasecloudmusicapienhanced/api@4.40.1 \
    && npm cache clean --force
COPY deploy/patch-netease-mobile-login.cjs /api/patch-netease-mobile-login.cjs
RUN node /api/patch-netease-mobile-login.cjs && rm /api/patch-netease-mobile-login.cjs
COPY deploy/netease.cjs /api/server.cjs
COPY deploy/netease-auth.cjs /api/netease-auth.cjs
COPY deploy/music-token.cjs /api/music-token.cjs
CMD ["node", "/api/server.cjs"]
