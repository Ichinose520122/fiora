# Chat hostname only, without https:// or a trailing slash.
FIORA_DOMAIN=chat.example.com
# Generate with: openssl rand -hex 32
FIORA_JWT_SECRET=
FIORA_INVITE_CODE=
DisableRegister=false
# true only when Fiora is reachable exclusively through your trusted proxy.
FIORA_TRUST_PROXY_HEADERS=true
# Optional MongoDB user IDs separated by commas; setting admins via CLI is simpler.
FIORA_ADMINISTRATOR=

# Leave at the default for the bundled music service.
# For the mainland China server, use its HTTPS domain, with no /search or /auth suffix.
NETEASE_API_URL=http://netease:3000
# Same value as MusicAuthToken on the remote music-api server; at least 32 characters.
NETEASE_API_TOKEN=
# Optional local fallback. Leave empty to avoid falling back to an overseas IP.
NETEASE_API_FALLBACK=
