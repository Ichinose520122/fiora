{
  "expo": {
    "name": "Fiora",
    "icon": "./icon.png",
    "version": "2.2.1",
    "description": "App for fiora. An online chatroom",
    "slug": "nekopara-fiora",
    "scheme": "fiora",
    "ios": {
      "bundleIdentifier": "cc.nekopara.chat",
      "buildNumber": "2.0.0",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "wxp"
        ],
        "CFBundleLocalizations": [
          "zh_CN"
        ],
        "CFBundleDevelopmentRegion": "zh_CN"
      }
    },
    "android": {
      "package": "cc.nekopara.chat",
      "versionCode": 2201,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "updates": {
      "enabled": false
    },
    "extra": {
      "serverUrl": "https://chat.nekopara.cc"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "选择聊天图片",
          "cameraPermission": "拍摄聊天图片",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": true
        }
      ]
    ]
  }
}
