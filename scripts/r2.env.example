# Create an R2 API token with Object Read & Write permission for one bucket.
# Do not commit the real values.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PREFIX=fiora-backups

# Optional:
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# AWS_CLI_IMAGE=amazon/aws-cli:2
